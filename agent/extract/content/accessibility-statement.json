                {
                  "type": "text",
                  "id": "et_pb_text_5",
                  "html": "<h3>Kitchen &amp;&nbsp;Living</h3> <ul> <li>Tiled flooring, 1 mat</li> <li>Worktop height 91cm.</li> <li>Electric oven ,door drop down, hob electric. Extractor fan with light.</li> <li>Dishwasher.</li> <li>Fridge &amp; separate freezer</li> <li>Fire extinguisher &amp; fire blanket.</li> <li>Microwave, toaster &amp; kettle</li> <li>Dustbin.</li> <li>Dining table 75cm high, 90 cm wide, 150cm long.</li> <li>6 dining chairs</li> <li>sideboard</li> </ul>",
                  "sansHeadings": {},
                  "hiddenOn": []
                }
              ]
            },
            {
              "size": "1_3",
              "modules": [
                {
                  "type": "text",
                  "id": "et_pb_text_6",
                  "html": "<h3>Sitting room</h3> <ul> <li>2 x 2 seater sofas, 2 armchairs, coffee table, 3 sidetables, sideboard.</li> <li>Tiled flooring, 1 rug.</li> <li>Electric fire.</li> <li>2 lamps</li> <li>Digital TV &amp; DVD Player Cd player</li> </ul>",
                  "sansHeadings": {},
                  "hiddenOn": []
                }
              ]
            },
            {
              "size": "1_3",
              "modules": [
                {
                  "type": "text",
                  "id": "et_pb_text_7",
                  "html": "<h3>Bedroom 1</h3> <ul> <li>Door from kitchen 70cm, door to ensuite 74cm</li> <li>5ft bed with head &amp; footboard, dressing table with mirror &amp; stool, wardrobe, chest of drawers, 2 bedside tables &amp; 2 lamps.</li> <li>Carpet</li> <li>Transfer space both sides 110cm.</li> <li>Bed height 54cm.</li> </ul>",
                  "sansHeadings": {},
                  "hiddenOn": []
                }
              ]
            }
